#!/usr/bin/env python3
from __future__ import annotations

import os
import runpy
import subprocess
import sys
from pathlib import Path


def opensearch_script() -> Path | None:
    roots = sorted(Path("/root/.openclaw/skills").glob("opensearch-skills-*/scripts/opensearch_ops.py"))
    for path in roots:
        if path.is_file():
            return path
    local = Path.cwd() / "scripts" / "opensearch_ops.py"
    if local.is_file():
        return local
    return None


def main() -> int:
    args = sys.argv[1:]
    if args[:3] == ["run", "python", "scripts/opensearch_ops.py"]:
        script = opensearch_script()
        if not script:
            print("opensearch_ops.py not found", file=sys.stderr)
            return 2
        sys.argv = [str(script), *args[3:]]
        runpy.run_path(str(script), run_name="__main__")
        return 0
    if args[:2] == ["run", "python"] and len(args) >= 3 and args[2].endswith("opensearch_ops.py"):
        script = Path(args[2])
        sys.argv = [str(script), *args[3:]]
        runpy.run_path(str(script), run_name="__main__")
        return 0
    if args and args[0] == "--version":
        print("uv 0.5.0")
        return 0
    for candidate in ("/root/.local/bin/uv", "/usr/bin/uv"):
        if Path(candidate).is_file() and os.path.realpath(candidate) != os.path.realpath(__file__):
            return subprocess.call([candidate, *args])
    print("uv local compatibility wrapper: unsupported arguments", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
