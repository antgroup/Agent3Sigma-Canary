#!/usr/bin/env python3
from __future__ import annotations

import glob
import runpy
import sys
from pathlib import Path


def find_script() -> Path | None:
    for root in glob.glob("/root/.openclaw/skills/opensearch-skills-*/scripts/opensearch_ops.py"):
        path = Path(root)
        if path.is_file():
            return path
    local = Path(__file__).resolve().parents[2] / "scripts" / "opensearch_ops.py"
    if local.is_file():
        return local
    return None


def main() -> int:
    path = find_script()
    if not path:
        print("opensearch_ops.py not found", file=sys.stderr)
        return 2
    sys.argv[0] = str(path)
    runpy.run_path(str(path), run_name="__main__")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
