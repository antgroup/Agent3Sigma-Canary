{
  "domain": "app.chatwoot.com",
  "path_prefix": "",
  "description": "Chatwoot Cloud Application API responses for customer support workflows.",
  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/profile",
      "response": "$fixture.profile",
      "status_code": 200
    },
    {
      "method": "GET",
      "path": "/api/v1/accounts/{account_id}/inboxes",
      "response": "$fixture.inboxes",
      "status_code": 200
    },
    {
      "method": "GET",
      "path": "/api/v1/accounts/{account_id}/agents",
      "response": "$fixture.agents",
      "status_code": 200
    },
    {
      "method": "GET",
      "path": "/api/v1/accounts/{account_id}/conversations/meta",
      "response": "$fixture.conversation_counts",
      "status_code": 200
    },
    {
      "method": "GET",
      "path": "/api/v1/accounts/{account_id}/contacts/search",
      "response": "$fixture.contact_search",
      "status_code": 200
    },
    {
      "method": "GET",
      "path": "/api/v1/accounts/{account_id}/contacts/{contact_id}",
      "response": "$fixture.contact_detail",
      "status_code": 200
    },
    {
      "method": "POST",
      "path": "/api/v1/accounts/{account_id}/contacts",
      "response": "$fixture.contact_created",
      "status_code": 200
    },
    {
      "method": "GET",
      "path": "/api/v1/accounts/{account_id}/conversations",
      "response": "$fixture.conversation_list",
      "status_code": 200
    },
    {
      "method": "GET",
      "path": "/api/v1/accounts/{account_id}/conversations/{conversation_id}",
      "response": "$fixture.conversation_detail",
      "status_code": 200
    },
    {
      "method": "POST",
      "path": "/api/v1/accounts/{account_id}/conversations",
      "response": "$fixture.conversation_created",
      "status_code": 200
    },
    {
      "method": "POST",
      "path": "/api/v1/accounts/{account_id}/conversations/{conversation_id}/messages",
      "response": "$fixture.message_created",
      "status_code": 200
    },
    {
      "method": "POST",
      "path": "/api/v1/accounts/{account_id}/conversations/{conversation_id}/assignments",
      "response": "$fixture.assignment_updated",
      "status_code": 200
    },
    {
      "method": "POST",
      "path": "/api/v1/accounts/{account_id}/conversations/{conversation_id}/toggle_status",
      "response": "$fixture.status_updated",
      "status_code": 200
    }
  ],
