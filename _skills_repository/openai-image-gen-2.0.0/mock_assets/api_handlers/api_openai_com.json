{
  "domain": "api.openai.com",
  "path_prefix": "/v1",
  "description": "Handler for OpenAI Images API used by gen.py.",
  "routes": [
    {
      "method": "POST",
      "path": "/v1/images/generations",
      "response": "$fixture.image_generation",
      "status_code": 200
    },
    {
      "method": "GET",
      "path": "/v1/models",
      "response": {
        "data": [
          {
            "id": "gpt-image-1.5",
            "object": "model"
          },
          {
            "id": "gpt-image-1",
            "object": "model"
          }
        ]
      },
      "status_code": 200
    }
  ],
  "fixtures": {
    "image_generation": {
      "created": 1735689600,
      "data": [
        {
          "b64_json": "",
          "revised_prompt": "A watercolor painting of a red panda eating bamboo, soft natural light."
        }
      ]
    }
  }
}
