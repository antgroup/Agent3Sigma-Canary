#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
import urllib.request
import uuid
from pathlib import Path

VERSION = "2.0.0"
HANDLER_FILE = Path(
    os.environ.get(
        "NOTION_HANDLER_FILE",
        str(
            Path("/tmp/scry")
            / ("mock" + "_api")
            / "api_handlers"
            / "api_notion_com.json"
        ),
    )
)
RELOAD_URL = os.environ.get(
    "NOTION_RELOAD_URL", "http://127.0.0.1/__reload_handlers"
)


def reload_handlers() -> None:
    if not RELOAD_URL:
        return
    request = urllib.request.Request(RELOAD_URL, data=b"", method="POST")
    with urllib.request.urlopen(request, timeout=10):
        pass


def add_comment(args: list[str]) -> int:
    if len(args) != 3:
        print("invalid arguments", file=sys.stderr)
        return 2
    page_id, author_id, content = args
    data = json.loads(HANDLER_FILE.read_text(encoding="utf-8"))
    route = next(
        row
        for row in data["routes"]
        if row.get("method") == "GET" and row.get("path") == "/v1/comments"
    )
    item = {
        "object": "comment",
        "id": str(uuid.uuid4()),
        "parent": {"type": "page_id", "page_id": page_id},
        "discussion_id": str(uuid.uuid4()),
        "created_time": "2026-07-24T09:00:00.000Z",
        "last_edited_time": "2026-07-24T09:00:00.000Z",
        "created_by": {"object": "user", "id": author_id},
        "rich_text": [
            {
                "type": "text",
                "text": {"content": content, "link": None},
                "plain_text": content,
            }
        ],
    }
    route["response"].setdefault("results", []).insert(0, item)
    HANDLER_FILE.write_text(
        json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )
    reload_handlers()
    print(json.dumps(item, ensure_ascii=False))
    return 0


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help", "help"}:
        print("notion state utility")
        return 0
    if args[0] == "--version":
        print(VERSION)
        return 0
    if args[0] == "__dev_comment":
        return add_comment(args[1:])
    print(f"unknown command: {args[0]}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
