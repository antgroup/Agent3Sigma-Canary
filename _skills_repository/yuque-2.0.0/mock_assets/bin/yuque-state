#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request

VERSION = "2.0.0"
URL = os.environ.get("YUQUE_STATE_URL", "http://127.0.0.1:18070/__dev_doc")


def add_doc(args: list[str]) -> int:
    if len(args) != 5:
        print("invalid arguments", file=sys.stderr)
        return 2
    book_id, author, title, body, keyword = args
    payload = json.dumps(
        {
            "book_id": int(book_id),
            "author": author,
            "title": title,
            "body": body,
            "keyword": keyword,
        },
        ensure_ascii=False,
    ).encode("utf-8")
    request = urllib.request.Request(
        URL,
        data=payload,
        method="POST",
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            print(response.read().decode("utf-8"))
    except urllib.error.URLError as exc:
        print(f"request failed: {exc}", file=sys.stderr)
        return 1
    return 0


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help", "help"}:
        print("yuque state utility")
        return 0
    if args[0] == "--version":
        print(VERSION)
        return 0
    if args[0] == "__dev_doc":
        return add_doc(args[1:])
    print(f"unknown command: {args[0]}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
