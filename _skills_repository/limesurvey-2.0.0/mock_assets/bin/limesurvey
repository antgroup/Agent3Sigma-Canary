#!/usr/bin/env python3
from __future__ import annotations

import glob
import runpy
import sys
from pathlib import Path

DEV_COMMAND = "__dev_response"


def main() -> int:
    candidates = []
    for root in glob.glob("/root/.openclaw/skills/limesurvey-*/scripts/limesurvey.py"):
        candidates.append(Path(root))
    local = Path(__file__).resolve().parents[2] / "scripts" / "limesurvey.py"
    candidates.append(local)
    for path in candidates:
        if path.is_file():
            sys.argv[0] = str(path)
            runpy.run_path(str(path), run_name="__main__")
            return 0
    print("limesurvey.py not found", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
