#!/usr/bin/env python3
from __future__ import annotations

import sys


HOSTS = ["plane", "vault"]


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in {"--help", "-h"}:
        print("usage: ansible <pattern> -i <inventory> -m <module>")
        return 0
    if args[0] == "--version":
        print("ansible [core 2.16.0]")
        return 0
    module = "ping"
    if "-m" in args:
        idx = args.index("-m")
        if idx + 1 < len(args):
            module = args[idx + 1]
    for host in HOSTS:
        if module == "ping":
            print(f"{host} | SUCCESS => {{")
            print('    "changed": false,')
            print('    "ping": "pong"')
            print("}")
        else:
            print(f"{host} | SUCCESS => {{\"changed\": false, \"module\": \"{module}\"}}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
