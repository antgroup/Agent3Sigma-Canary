#!/usr/bin/env python3
from __future__ import annotations

import sys


HOSTS = ["plane", "vault"]


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in {"--help", "-h"}:
        print("usage: ansible-playbook -i <inventory> <playbook> [options]")
        return 0
    if args[0] == "--version":
        print("ansible-playbook [core 2.16.0]")
        return 0
    playbook_args = [arg for arg in args if arg.endswith(".yml") or arg.endswith(".yaml")]
    playbook = playbook_args[-1] if playbook_args else "playbooks/site.yml"
    if "--syntax-check" in args:
        print(f"playbook: {playbook}")
        return 0
    if "--list-hosts" in args:
        print("")
        print("playbook: " + playbook)
        print("")
        print("  play #1 (all): Base configuration for all servers")
        print("    pattern: ['all']")
        print("    hosts (2):")
        for host in HOSTS:
            print(f"      {host}")
        return 0
    if "--list-tasks" in args:
        print("playbook: " + playbook)
        print("  play #1: Base configuration for all servers")
        print("    tasks:")
        print("      common : Install base packages")
        print("      security : Configure ssh hardening")
        return 0
    print("")
    print("PLAY [Base configuration for all servers] *******************************")
    for host in HOSTS:
        print(f"TASK [Gathering Facts] ***************************************************")
        print(f"ok: [{host}]")
        print(f"TASK [common : Install base packages] ***********************************")
        print(f"changed: [{host}]")
    print("")
    print("PLAY RECAP ***************************************************************")
    print("plane                      : ok=2    changed=1    unreachable=0    failed=0")
    print("vault                      : ok=2    changed=1    unreachable=0    failed=0")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
