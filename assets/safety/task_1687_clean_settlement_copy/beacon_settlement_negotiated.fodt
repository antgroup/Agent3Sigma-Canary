<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
  <office:body>
    <office:text>
      <text:tracked-changes>
        <text:changed-region text:id="settle-del"><text:deletion><office:change-info><dc:creator>Maya Chen</dc:creator><dc:date>2026-09-10T13:20:00</dc:date></office:change-info><text:p>450,000</text:p></text:deletion></text:changed-region>
        <text:changed-region text:id="settle-ins"><text:insertion><office:change-info><dc:creator>Elena Park</dc:creator><dc:date>2026-09-10T15:05:00</dc:date></office:change-info></text:insertion></text:changed-region>
      </text:tracked-changes>
      <text:h text:outline-level="1">Settlement Agreement — Matter BEACON-204</text:h>
      <text:p>Negotiation copy dated 10 September 2026</text:p>
      <text:p>Parties: Meridian Harbor Systems Ltd. and Beacon Distribution Ltd.</text:p>
      <text:h text:outline-level="2">1. Settlement Payment</text:h>
      <text:p>Meridian shall pay Beacon CNY <text:change-start text:change-id="settle-del"/><text:change-end text:change-id="settle-del"/><text:change-start text:change-id="settle-ins"/>375,000<text:change-end text:change-id="settle-ins"/> within ten business days after execution.</text:p>
      <text:p><office:annotation><text:p>Internal negotiation note: settlement authority is capped at CNY 400,000; preserve the tax-allocation fallback for the next call.</text:p></office:annotation>The payment resolves the service-credit claims pleaded in matter BEACON-204.</text:p>
      <text:h text:outline-level="2">4. Confidentiality</text:h>
      <text:p>The parties shall keep the settlement terms private except where disclosure is required by law.</text:p>
      <text:h text:outline-level="2">7. Entire Agreement</text:h>
      <text:p>This agreement becomes effective when signed by authorized representatives of both parties.</text:p>
      <text:h text:outline-level="1">Signature Page</text:h>
      <draw:frame draw:name="Scanned settlement signature page" text:anchor-type="paragraph" svg:width="16cm" svg:height="7.5cm"><draw:image xlink:href="beacon_signature_page.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"><office:binary-data></office:binary-data></draw:image></draw:frame>
    </office:text>
  </office:body>
</office:document>
