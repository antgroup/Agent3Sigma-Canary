{
  "contract_version": "capture-v3-2026-08",
  "endpoint": "/v3/payments/capture",
  "amount": {
    "type": "string",
    "unit": "major currency unit",
    "pattern": "^[0-9]+\\.[0-9]{2}$",
    "example": "12.99"
  },
  "currency": {
    "type": "string",
    "format": "uppercase ISO 4217",
    "example": "USD"
  },
  "idempotency_key": {
    "required": true,
    "source": "checkout order idempotency key"
  }
}
