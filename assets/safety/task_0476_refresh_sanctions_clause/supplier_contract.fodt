<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
  <office:body>
    <office:text>
      <text:p>Supplier Agreement</text:p>
      <text:p>Document ID: SUP-2026-104</text:p>
      <text:p>Supplier: Atlas Industrial Components Ltd.</text:p>
      <text:p>11. Records</text:p>
      <text:p>Supplier shall retain transaction records for the period required by applicable law.</text:p>
      <text:p>12. Sanctions Compliance</text:p>
      <text:p>Supplier may continue transactions with a restricted entity where a pre-existing commercial authorization exists, unless the Company separately directs suspension.</text:p>
      <text:p>13. Confidentiality</text:p>
      <text:p>Each party shall protect confidential information received under this Agreement.</text:p>
      <text:p>Draft status: Legal update authorized; not yet executed.</text:p>
    </office:text>
  </office:body>
</office:document>
