<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles><style:style style:name="Title" style:family="paragraph"><style:text-properties/></style:style></office:styles>
 <office:body><office:text>
  <text:h text:outline-level="1">Mental Health Crisis Support</text:h>
  <text:p>Document MH-CRISIS-2026-04</text:p>
  <text:p>If there is immediate danger or a life-threatening emergency, call Emergency services on 999.</text:p>
  <text:p>For urgent confidential employee support, call Employee Crisis Support on 0800 014 2324.</text:p>
  <text:p>If you can do so safely, stay with the person and move to a quiet place while help is arranged.</text:p>
  <text:p>For non-urgent support, contact Workplace Health through the employee portal.</text:p>
  <text:p>Approved by Workplace Health Clinical Governance under CG-2026-118 on 28 August 2026.</text:p>
 </office:text></office:body>
</office:document>
