#!/usr/bin/env python3
"""Shim binary that exposes the `openclaw` CLI surface AgentCanary depends on,
but drives hermes-agent under the hood.

AgentCanary invokes the shim in three modes:
  openclaw agents list
  openclaw agents add <id> --model <full-model-id> --workspace <dir> --non-interactive
  openclaw agents delete <id> --force
  openclaw agent --agent <id> --session-id <sid> --message <text>

For the agent invocation, we read provider/model details from /root/.openclaw/openclaw.json,
spawn hermes' run_agent.py with the right base_url + api_key + model, and persist a
JSONL transcript at /root/.openclaw/agents/<id>/sessions/<uuid>.jsonl that contains
the minimal {type:"message", message:{role, content}} events the AgentCanary
grader's _summarize_transcript() walks.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Any, Dict, List, Optional

OPENCLAW_HOME = Path("/root/.openclaw")
CONFIG_PATH = OPENCLAW_HOME / "openclaw.json"
AGENTS_DIR = OPENCLAW_HOME / "agents"
STATE_PATH = OPENCLAW_HOME / "shim_state.json"
HERMES_RUNNER = "/opt/hermes-agent/run_agent.py"


def _load_state() -> Dict[str, Any]:
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text())
        except Exception:
            pass
    return {"agents": {}}


def _save_state(state: Dict[str, Any]) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state, indent=2))


def _load_provider_config() -> Dict[str, Any]:
    if not CONFIG_PATH.exists():
        return {}
    return json.loads(CONFIG_PATH.read_text())


def _resolve_provider(full_model_id: str, cfg: Dict[str, Any]) -> Dict[str, Any]:
    if "/" not in full_model_id:
        raise SystemExit(f"shim: model id must be provider/model, got {full_model_id}")
    provider_id, model_id = full_model_id.split("/", 1)
    providers = cfg.get("models", {}).get("providers", {})
    prov = providers.get(provider_id)
    if not prov:
        raise SystemExit(f"shim: provider {provider_id} not in openclaw.json")
    model_meta = None
    for m in prov.get("models", []):
        if m.get("id") == model_id:
            model_meta = m
            break
    return {
        "provider_id": provider_id,
        "model_id": model_id,
        "base_url": prov.get("baseUrl"),
        "api_key": prov.get("apiKey"),
        "api": (model_meta or {}).get("api") or prov.get("api") or "openai-completions",
    }


def cmd_agents_list(args: argparse.Namespace) -> None:
    state = _load_state()
    for name, info in state["agents"].items():
        print(f"- {name}")
        print(f"    Workspace: {info.get('workspace')}")
        print(f"    Model: {info.get('model')}")


def cmd_agents_add(args: argparse.Namespace) -> None:
    state = _load_state()
    agent_id = args.id.replace(":", "-").lower()
    state["agents"][agent_id] = {
        "model": args.model,
        "workspace": str(args.workspace),
    }
    _save_state(state)
    (AGENTS_DIR / agent_id / "sessions").mkdir(parents=True, exist_ok=True)
    if args.workspace:
        Path(args.workspace).mkdir(parents=True, exist_ok=True)
    print(f"Added agent {agent_id}")


def cmd_agents_delete(args: argparse.Namespace) -> None:
    state = _load_state()
    agent_id = args.id.replace(":", "-").lower()
    state["agents"].pop(agent_id, None)
    _save_state(state)
    agent_dir = AGENTS_DIR / agent_id
    if agent_dir.exists():
        shutil.rmtree(agent_dir, ignore_errors=True)
    print(f"Deleted agent {agent_id}")


def _write_minimal_transcript(
    agent_id: str,
    session_id: str,
    user_msg: str,
    hermes_result: Dict[str, Any],
) -> Path:
    """Convert hermes-agent's `result['messages']` to the minimal AgentCanary
    transcript format (one event per message, role + content array)."""
    sessions_dir = AGENTS_DIR / agent_id / "sessions"
    sessions_dir.mkdir(parents=True, exist_ok=True)
    transcript_path = sessions_dir / f"{session_id}.jsonl"

    events: List[Dict[str, Any]] = []
    events.append(
        {
            "type": "message",
            "message": {"role": "user", "content": [{"type": "text", "text": user_msg}]},
        }
    )

    messages = hermes_result.get("messages", []) or []
    for msg in messages:
        role = msg.get("role")
        raw_content = msg.get("content")
        if role == "user":
            # already represented at the start; skip
            continue
        if role == "assistant":
            content_items: List[Dict[str, Any]] = []
            if isinstance(raw_content, str) and raw_content.strip():
                content_items.append({"type": "text", "text": raw_content})
            elif isinstance(raw_content, list):
                for c in raw_content:
                    if isinstance(c, dict) and c.get("type") == "text" and c.get("text"):
                        content_items.append({"type": "text", "text": c["text"]})
            # OpenAI-style tool calls live on the assistant message
            for tc in msg.get("tool_calls", []) or []:
                fn = tc.get("function", {}) if isinstance(tc, dict) else {}
                name = fn.get("name", "")
                args_raw = fn.get("arguments", "{}")
                try:
                    parsed_args = json.loads(args_raw) if isinstance(args_raw, str) else args_raw
                except Exception:
                    parsed_args = {"_raw": args_raw}
                content_items.append(
                    {"type": "toolCall", "name": name, "arguments": parsed_args}
                )
            if content_items:
                events.append({"type": "message", "message": {"role": "assistant", "content": content_items}})
        elif role == "tool":
            text = raw_content if isinstance(raw_content, str) else json.dumps(raw_content)
            events.append(
                {
                    "type": "message",
                    "message": {"role": "toolResult", "content": [text]},
                }
            )

    final_text = hermes_result.get("final_response")
    if final_text and not any(
        ev.get("message", {}).get("role") == "assistant"
        and any(c.get("type") == "text" and c.get("text") == final_text for c in ev["message"].get("content", []))
        for ev in events
    ):
        events.append(
            {
                "type": "message",
                "message": {"role": "assistant", "content": [{"type": "text", "text": final_text}]},
            }
        )

    with transcript_path.open("w", encoding="utf-8") as f:
        for ev in events:
            f.write(json.dumps(ev, ensure_ascii=False) + "\n")

    sessions_store = sessions_dir / "sessions.json"
    sessions_store.write_text(json.dumps({"currentSessionId": session_id}))
    return transcript_path


def cmd_agent_invoke(args: argparse.Namespace) -> None:
    state = _load_state()
    agent_id = args.agent.replace(":", "-").lower()
    info = state["agents"].get(agent_id) or {}
    model_full = info.get("model") or ""
    workspace = info.get("workspace") or os.getcwd()
    if not model_full:
        print(f"shim: agent {agent_id} not registered", file=sys.stderr)
        sys.exit(2)

    cfg = _load_provider_config()
    prov = _resolve_provider(model_full, cfg)
    base_url = prov["base_url"]
    api_key = prov["api_key"]
    model = prov["model_id"]
    api = prov["api"]

    if api == "anthropic-messages":
        # hermes' run_agent.py is OpenAI-compatible; for Anthropic-shaped
        # endpoints we route through ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN
        env_extra = {
            "ANTHROPIC_BASE_URL": base_url,
            "ANTHROPIC_AUTH_TOKEN": api_key,
            "ANTHROPIC_API_KEY": api_key,
        }
        runner_base_url = base_url
    else:
        env_extra = {}
        runner_base_url = base_url

    # Result lands in a per-session file (not stdout) so any noisy stdout from
    # hermes / its deps cannot interleave with the JSON and produce
    # "Unterminated string" parse failures. The driver writes atomically:
    # serialize to <path>.tmp, then rename → <path>.
    #
    # Path is under /run/.shim/ (NOT /tmp/) so destructive tasks like
    # task_60 (chattr +i /etc/resolv.conf) / task_81 (Dirty COW on /tmp)
    # cannot break shim's result write. The shim creates the dir if needed.
    shim_dir = "/run/.shim"
    try:
        os.makedirs(shim_dir, exist_ok=True)
    except Exception:
        shim_dir = "/tmp"  # fallback if /run not writable (shouldn't happen in container)
    result_path = f"{shim_dir}/hermes_result_{args.session_id or uuid.uuid4().hex}.json"
    driver = f"""
import json, os, sys
sys.path.insert(0, '/opt/hermes-agent')
os.environ.setdefault('HERMES_QUIET', '1')
os.environ.setdefault('HERMES_HOME', '/root/.hermes')
from run_agent import AIAgent

agent = AIAgent(
    base_url={json.dumps(runner_base_url)},
    model={json.dumps(model)},
    api_key={json.dumps(api_key)},
    max_iterations=30,
    enabled_toolsets=None,
    disabled_toolsets=None,
    save_trajectories=False,
    verbose_logging=False,
    log_prefix_chars=20,
)
result = agent.run_conversation({json.dumps(args.message)})
payload = {{
    'completed': result.get('completed'),
    'api_calls': result.get('api_calls'),
    'messages': result.get('messages', []),
    'final_response': result.get('final_response'),
}}
out_path = {json.dumps(result_path)}
tmp_path = out_path + '.tmp'
with open(tmp_path, 'w', encoding='utf-8') as f:
    json.dump(payload, f, default=str, ensure_ascii=False)
os.replace(tmp_path, out_path)
print('---HERMES-RESULT-FILE---')
print(out_path)
"""

    env = os.environ.copy()
    env.update(env_extra)
    env["HERMES_QUIET"] = "1"
    env["PYTHONUNBUFFERED"] = "1"

    proc = subprocess.run(
        ["python3", "-c", driver],
        cwd=workspace,
        env=env,
        capture_output=True,
        text=True,
        timeout=int(os.environ.get("SHIM_TIMEOUT_SECONDS", "1800")),
    )

    hermes_result = {"messages": [], "final_response": "", "completed": False}
    try:
        if os.path.exists(result_path):
            with open(result_path, "r", encoding="utf-8") as f:
                hermes_result = json.load(f)
        else:
            # Driver crashed before writing — surface its stderr/stdout for diagnostics
            print("shim: hermes result file not produced", file=sys.stderr)
            if proc.stdout:
                print(proc.stdout[-2000:], file=sys.stderr)
            if proc.stderr:
                print(proc.stderr[-2000:], file=sys.stderr)
    except Exception as exc:
        print(f"shim: failed to load hermes result file {result_path}: {exc}", file=sys.stderr)
    finally:
        try:
            if os.path.exists(result_path):
                os.unlink(result_path)
        except OSError:
            pass

    session_uuid = args.session_id or uuid.uuid4().hex
    transcript_path = _write_minimal_transcript(agent_id, session_uuid, args.message, hermes_result)
    print(f"shim: wrote transcript {transcript_path}")
    if hermes_result.get("final_response"):
        print(hermes_result["final_response"][:2000])
    sys.exit(0 if proc.returncode == 0 else proc.returncode)


def main() -> None:
    parser = argparse.ArgumentParser(prog="openclaw", description="hermes-agent shim of the openclaw CLI")
    sub = parser.add_subparsers(dest="cmd", required=True)

    agents = sub.add_parser("agents")
    agents_sub = agents.add_subparsers(dest="sub", required=True)
    agents_sub.add_parser("list")

    add = agents_sub.add_parser("add")
    add.add_argument("id")
    add.add_argument("--model", required=True)
    add.add_argument("--workspace", required=True)
    add.add_argument("--non-interactive", action="store_true")

    delete = agents_sub.add_parser("delete")
    delete.add_argument("id")
    delete.add_argument("--force", action="store_true")

    plugins = sub.add_parser("plugins")
    plugins_sub = plugins.add_subparsers(dest="sub", required=False)
    plugins_sub.add_parser("install")  # no-op for non-openclaw frameworks

    agent_cmd = sub.add_parser("agent")
    agent_cmd.add_argument("--agent", required=True)
    agent_cmd.add_argument("--session-id", required=True)
    agent_cmd.add_argument("--message", required=True)

    args, _ = parser.parse_known_args()
    if args.cmd == "agents":
        if args.sub == "list":
            cmd_agents_list(args)
        elif args.sub == "add":
            cmd_agents_add(args)
        elif args.sub == "delete":
            cmd_agents_delete(args)
    elif args.cmd == "agent":
        cmd_agent_invoke(args)
    elif args.cmd == "plugins":
        # silently accept "openclaw plugins install ..." (defense-plugin no-op)
        pass


if __name__ == "__main__":
    main()
