#!/usr/bin/env python3
"""codex variant of the AgentCanary CLI shim.

Drives the first-party OpenAI Codex CLI (`codex exec --json`) and persists a
transcript at /root/.openclaw/agents/<id>/sessions/<uuid>.jsonl in the minimal
AgentCanary format expected by lib_grading._summarize_transcript.

Permission regime is selected at runtime via the CODEX_PERMISSION_MODE env var
(passed through `docker exec` by the host):

  - auto-review -> `-s workspace-write` + approval_policy="on-request" +
                   approvals_reviewer="auto_review". Codex runs commands inside
                   its own bwrap sandbox; anything that hits the sandbox
                   boundary escalates and is reviewed by the built-in guardian
                   reviewer sub-agent instead of a human.
  - yolo        -> `--dangerously-bypass-approvals-and-sandbox`: no sandbox and
                   no approvals (analogue of Claude Code bypassPermissions).

Two integration contracts:

1. Codex speaks the OpenAI **Responses API** only — `wire_api = "chat"` was
   removed in 0.14x. The shim therefore derives an OpenAI-style base URL from
   the openclaw.json provider entry (or CODEX_BASE_URL) rather than reusing the
   Anthropic-messages URL that the claude_code image uses.

2. The guardian reviewer resolves its model from the model *catalog*, defaulting
   to the slug `codex-auto-review` which no third-party endpoint serves. If that
   slug is unavailable the review fails and every boundary action is denied
   (fail-closed). The shim therefore synthesises `$CODEX_HOME/models_catalog.json`
   from /opt/codex/model_template.json with the run's actual model slug and an
   explicit `auto_review_model_override`, so the reviewer is pointed at a model
   the endpoint really serves. Unlike Claude Code (where the classifier model is
   not configurable at all), this means task model and reviewer model *can* be
   set independently — via CODEX_AUTO_REVIEW_MODEL.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List

from agentcanary_runtime import atomic_text, invocation_deadline, read_jsonl, run_process

OPENCLAW_HOME = Path("/root/.openclaw")
CONFIG_PATH = OPENCLAW_HOME / "openclaw.json"
AGENTS_DIR = OPENCLAW_HOME / "agents"
STATE_PATH = OPENCLAW_HOME / "shim_state.json"
CODEX_HOME = Path(os.environ.get("CODEX_HOME", "/root/.codex"))
MODEL_TEMPLATE = Path("/opt/codex/model_template.json")
SKILLS_DIR = "/root/.agents/skills"


def _codex_bin() -> str:
    for cand in ("codex", "/usr/local/bin/codex"):
        found = shutil.which(cand) if "/" not in cand else (cand if Path(cand).exists() else None)
        if found:
            return found
    return "codex"


def _load_state() -> Dict[str, Any]:
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text())
        except Exception:
            pass
    return {"agents": {}}


def _save_state(state: Dict[str, Any]) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state, indent=2))


def _load_provider_config() -> Dict[str, Any]:
    if not CONFIG_PATH.exists():
        return {}
    return json.loads(CONFIG_PATH.read_text())


def _openai_base_url(base_url: str | None) -> str:
    """Map an openclaw provider baseUrl onto the OpenAI-compatible root.

    openclaw.json stores the Anthropic-messages URL (…/api/anthropic) because the
    claude_code image needs it. Codex needs the OpenAI Responses root instead
    (…/v1). Explicit CODEX_BASE_URL always wins.
    """
    override = os.environ.get("CODEX_BASE_URL")
    if override:
        return override.rstrip("/")
    url = (base_url or "").rstrip("/")
    if not url:
        return ""
    for suffix in ("/api/anthropic", "/anthropic"):
        if url.endswith(suffix):
            return url[: -len(suffix)] + "/v1"
    if url.endswith("/v1"):
        return url
    return url + "/v1"


def _resolve_provider(full_model_id: str, cfg: Dict[str, Any]) -> Dict[str, Any]:
    if "/" not in full_model_id:
        raise SystemExit(f"shim: model id must be provider/model, got {full_model_id}")
    provider_id, model_id = full_model_id.split("/", 1)
    providers = cfg.get("models", {}).get("providers", {})
    prov = providers.get(provider_id) or {}
    return {
        "provider_id": provider_id,
        "model_id": model_id,
        "base_url": _openai_base_url(prov.get("baseUrl")),
        "api_key": prov.get("apiKey"),
    }


def cmd_agents_list(args: argparse.Namespace) -> None:
    state = _load_state()
    for name, info in state["agents"].items():
        print(f"- {name}")
        print(f"    Workspace: {info.get('workspace')}")
        print(f"    Model: {info.get('model')}")


def cmd_agents_add(args: argparse.Namespace) -> None:
    state = _load_state()
    agent_id = args.id.replace(":", "-").lower()
    state["agents"][agent_id] = {"model": args.model, "workspace": str(args.workspace)}
    _save_state(state)
    (AGENTS_DIR / agent_id / "sessions").mkdir(parents=True, exist_ok=True)
    if args.workspace:
        Path(args.workspace).mkdir(parents=True, exist_ok=True)
    print(f"Added agent {agent_id}")


def cmd_agents_delete(args: argparse.Namespace) -> None:
    state = _load_state()
    agent_id = args.id.replace(":", "-").lower()
    state["agents"].pop(agent_id, None)
    sessions = state.get("sessions")
    if isinstance(sessions, dict):
        for key in list(sessions):
            if key.startswith(f"{agent_id}:"):
                sessions.pop(key, None)
    _save_state(state)
    agent_dir = AGENTS_DIR / agent_id
    if agent_dir.exists():
        shutil.rmtree(agent_dir, ignore_errors=True)
    print(f"Deleted agent {agent_id}")


